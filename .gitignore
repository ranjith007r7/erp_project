# Backend
backend/venv/
backend/.env
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env
frontend/.env.local

# General
.DS_Store
*.log

# Broadened to catch these folder names at ANY depth, not just the
# fixed paths above - closes the real gap found when an archived
# old_Phase snapshot's own nested venv/node_modules weren't covered
# by the fixed-path rules alone.
**/venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.next/
old_Phase/