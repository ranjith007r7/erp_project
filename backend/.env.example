# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to GitHub - only this .example file.

DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_db

# MUST be a real random value - the app now refuses to start with the
# placeholder text below or an empty value (see app/core/config.py).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-string-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

ALLOWED_ORIGINS=http://localhost:3000

# --- Login rate limiting (Phase 13) ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Password reset / email verification token lifetime (Phase 13) ---
RESET_TOKEN_EXPIRE_MINUTES=60
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- Invite-by-email token lifetime ---
# Longer than verification/reset on purpose - an invitee might not check
# their email the same day they're invited, unlike a password reset
# which is usually urgent.
INVITE_TOKEN_EXPIRE_HOURS=168

# --- Real email delivery (Resend) ---
# Get a free API key at resend.com (3,000 emails/month, 100/day, no
# credit card, no expiry) - sign up with the email you want test emails
# delivered to (see MANUAL.md for why, until a custom domain is verified).
# Leave empty to fall back to logging emails to the console instead of
# sending them - this is what happens automatically in local dev and CI.
RESEND_API_KEY=

# Must be your real deployed frontend URL in production (e.g.
# https://your-app.vercel.app) - this is what verification/reset/invite
# links in emails will point to. Left as localhost here for local dev.
FRONTEND_URL=http://localhost:3000

# --- Scheduled jobs (GitHub Actions cron) ---
# A shared secret ONLY GitHub Actions' scheduled workflow knows - not a
# user password. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and put the SAME value in this Render env var AND in GitHub's repo
# secrets (Settings -> Secrets and variables -> Actions -> CRON_SECRET).
# Leave empty to disable both scheduled-job endpoints entirely (they
# reject every request with no valid secret configured).
CRON_SECRET=

# --- Real file storage (Cloudflare R2) ---
# Get these from dash.cloudflare.com -> R2 -> create a bucket -> Manage
# R2 API Tokens. Note: Cloudflare requires a credit card on file to
# enable R2 even on the free tier (10GB storage, zero egress fees,
# forever) - you won't be charged unless you exceed those limits.
# Leave any of these empty to disable uploads entirely - the app boots
# and runs fully without them; upload/download return a clear 503
# instead of crashing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
MAX_UPLOAD_SIZE_MB=10

# --- Unified Intelligence Layer (plain-English questions over ERP data) ---
# Everything below is OPTIONAL: leave it empty and the whole ERP still works;
# only /api/intelligence answers 503 with a clear "not configured" message.
#
# GEMINI_API_KEY: a FREE key from https://aistudio.google.com (no credit card).
#   * Free-tier prompts/responses MAY BE USED BY GOOGLE TO TRAIN ITS MODELS and
#     read by reviewers. Use SYNTHETIC / non-sensitive data only.
#   * Do NOT enable billing on that Google project: it leaves the free tier.
#   * Limits (roughly 10-15 requests/min plus a daily cap) are per Google
#     PROJECT, not per key, and are shown in your own AI Studio dashboard.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
#
# UIL_DATABASE_URL: the dedicated READ-ONLY database login the AI's queries run
# as. Create it once with scripts/setup_uil_role.py, then point this at it:
#   postgresql://uil_readonly:<UIL_DB_PASSWORD>@<same host>:<port>/<same database>
# (On Supabase's pooler the username may need to be uil_readonly.<project-ref>.)
UIL_DATABASE_URL=
UIL_MAX_ROWS=200
UIL_STATEMENT_TIMEOUT_MS=5000
# false = result rows are NEVER sent to the LLM (you get the raw table only).
UIL_SEND_ROWS_TO_LLM=true
UIL_MAX_HISTORY_EXCHANGES=4
