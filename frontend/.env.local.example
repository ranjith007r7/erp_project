# Copy this to .env.local for local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. The timezone timestamps (audit log, notifications) are shown in.
# Defaults to Asia/Kolkata (IST) when unset. Public, not a secret.
# NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Branding (all optional; public, not secret; rebuild after changing).
# Defaults are shown. Put a logo file under frontend/public/ and point LOGO_URL at it, e.g. /brand/logo.png
# NEXT_PUBLIC_PRODUCT_NAME=Ratoon ERP
# NEXT_PUBLIC_COMPANY_NAME=Ratoon Infotech
# NEXT_PUBLIC_TAGLINE=Run your whole business from one place.
# NEXT_PUBLIC_LOGO_URL=
