# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to GitHub - only this .example file.

DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_db

# MUST be a real random value - the app now refuses to start with the
# placeholder text below or an empty value (see app/core/config.py).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-string-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

ALLOWED_ORIGINS=http://localhost:3000

# --- Login rate limiting (Phase 13) ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Password reset / email verification token lifetime (Phase 13) ---
RESET_TOKEN_EXPIRE_MINUTES=60
VERIFICATION_TOKEN_EXPIRE_HOURS=24
